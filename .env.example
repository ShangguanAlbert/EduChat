# Metrix 环境变量示例
# 复制为 .env 后填写真实值；不要提交 .env。

# =========================
# 应用基础配置
# =========================
PORT=8787
EDUCHAT_BASE_PATH=/
MONGO_URI=mongodb://127.0.0.1:27017/educhat
AUTH_SECRET=replace_with_a_long_random_secret
GROUP_CHAT_WS_AUTH_TIMEOUT_MS=10000

# =========================
# 对话与生成 Provider 密钥
# =========================
# 阿里云 DashScope（群聊 AI / Qwen）
ALIYUN_API_KEY=your_aliyun_api_key
# DASHSCOPE_API_KEY=your_aliyun_api_key

# 火山引擎 Ark（对话与图片）
VOLCENGINE_API_KEY=your_volcengine_api_key
# ARK_API_KEY=your_volcengine_api_key
VOLCENGINE_IMAGE_API_KEY=your_volcengine_image_api_key

# PackyCode（Agent A）
PACKYCODE_API_KEY=your_packycode_api_key

# MiniMax（仅音乐、歌词生成）
MINIMAX_API_KEY=your_minimax_api_key

# =========================
# Provider 服务地址与模型
# 未填写时会使用服务端内置默认地址。
# =========================
PACKYCODE_CHAT_ENDPOINT=https://www.packyapi.com/v1/chat/completions

ALIYUN_CHAT_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
ALIYUN_RESPONSES_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/responses
ALIYUN_DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
ALIYUN_DASHSCOPE_MULTIMODAL_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

VOLCENGINE_RESPONSES_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses
VOLCENGINE_IMAGE_GENERATION_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
VOLCENGINE_IMAGE_GENERATION_MODEL=doubao-seedream-4-5-251128
# 可选：兼容模型走 Chat Completions 时使用。
# VOLCENGINE_CHAT_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# VOLCENGINE_FILES_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/files
# VOLCENGINE_FILES_VIDEO_FPS=0.3
# VOLCENGINE_RESPONSES_REASONING_MODELS=model-a,model-b

MINIMAX_MUSIC_ENDPOINT=https://api.minimaxi.com/v1/music_generation
MINIMAX_LYRICS_ENDPOINT=https://api.minimaxi.com/v1/lyrics_generation

# =========================
# 群聊 AI 队列
# 本地开发使用已启动的 Redis；Docker Compose 会覆盖为 redis://redis:6379。
# =========================
GROUP_CHAT_AI_REDIS_URL=redis://127.0.0.1:6380
GROUP_CHAT_AI_REDIS_PREFIX=educhat:group-chat-ai

# =========================
# 阿里云 OSS（群任务附件、聊天附件）
# 生产建议 Bucket 私有，通过签名 URL 下载。
# =========================
ALIYUN_OSS_BUCKET=your_bucket
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# public（本地）/ internal_prefer（ECS 推荐）/ internal_only
ALIYUN_OSS_NETWORK_MODE=public
ALIYUN_OSS_OBJECT_PREFIX=educhat/
ALIYUN_OSS_SIGNED_URL_TTL_SECONDS=900
ALIYUN_OSS_PUBLIC_READ=false
# 兼容旧配置：仅当 ALIYUN_OSS_NETWORK_MODE 未设置时生效。
ALIYUN_OSS_INTERNAL=false
ALIYUN_OSS_SECURE=true
ALIYUN_OSS_STARTUP_CHECK_ENABLED=true
ALIYUN_OSS_STARTUP_WRITE_PROBE=false
ALIYUN_OSS_STARTUP_CHECK_TIMEOUT_MS=5000
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret

# =========================
# 账号与课堂测试
# 所有内容仅由服务端读取。
# =========================
# 示例: [{"username":"admin1","password":"replace_me"}]
FIXED_ADMIN_ACCOUNTS=[]
# 支持数组或按班级分组的对象；示例: {"810班":[{"username":"张三","studentId":"20260001"}]}
FIXED_STUDENT_ACCOUNTS={}
FINAL_TEST_TURNBACK_PASSPHRASE=please_set_turnback_passphrase
FINAL_TEST_RESTART_PASSPHRASE=please_set_restart_passphrase

# =========================
# 文档预览
# Word 预览通过 LibreOffice/soffice 转 PDF；留空时从 PATH 查找。
# =========================
# EDUCHAT_DOCUMENT_PREVIEW_SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# =========================
# Docker Compose 的 MongoDB 初始化参数
# 生产请替换默认口令。
# =========================
MONGO_DB_NAME=educhat
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me

# =========================
# 对话 Agent 启动期默认项
# A 固定为 PackyCode，B 固定为 reserved 占位，D/群聊 AI 由 MongoDB 后台配置管理。
# =========================
AGENT_PROVIDER_C=volcengine
AGENT_MODEL_A=gpt-5.4
AGENT_MODEL_C=doubao-seed-2-0-pro-260215
DEFAULT_SYSTEM_PROMPT=
